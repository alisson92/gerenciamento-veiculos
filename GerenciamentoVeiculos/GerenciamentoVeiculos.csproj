<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Dependência indireta do SqlClient fixada em versão corrigida:
         o SqlClient 7.1.1 traz o System.Security.Cryptography.Pkcs 9.0.18, que possui
         vulnerabilidades conhecidas (CVE-2026-70162 e CVE-2026-84008, avisos NU1902/NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
